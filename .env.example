# Copy this file to .env.local (which is already git-ignored) and fill in
# your own key. Never commit real API keys to the repository.

# Required — get a free key at https://aistudio.google.com/apikey (sign in
# with your Google account, no billing needed for the free tier — that's
# enough for a low-traffic site like this one).
GEMINI_API_KEY=

# Optional — overrides the default model used by the AI chat widget
# (src/app/api/chat/route.ts). Defaults to gemini-3.6-flash if unset.
GEMINI_MODEL=gemini-3.6-flash

# --- Contact form email (src/app/api/contact/route.ts) ---------------------

# Required — get a free key at https://resend.com (sign up, then
# Dashboard -> API Keys -> Create API Key). No card needed for the free
# tier (3,000 emails/month).
RESEND_API_KEY=

# Optional — who the email appears to come from. Until you verify your own
# domain in Resend (Dashboard -> Domains -> Add Domain, then add the DNS
# records it gives you at your domain registrar), you can only send from
# onboarding@resend.dev, and delivery is most reliable to the email address
# you signed up to Resend with. Once growvibe.io is verified, change this to
# something like: GrowVibe <hello@growvibe.io>
RESEND_FROM_EMAIL=GrowVibe Website <onboarding@resend.dev>

# Optional — where form submissions get delivered. Defaults to
# hello@growvibe.io if unset.
CONTACT_TO_EMAIL=hello@growvibe.io

# --- Google Analytics 4 (src/components/google-analytics.tsx) --------------

# Your GA4 Measurement ID, e.g. G-XXXXXXXXXX (Admin -> Data Streams -> your
# web stream, in the Google Analytics dashboard). Only loads in production
# builds — local `npm run dev` never sends analytics events.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
